QMainWindow, QWidget {
    background-color: #0B0E14;
    color: #A9B1D6;
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

QTabWidget::pane {
    border: 1px solid #1A1B26;
    background-color: #0B0E14;
}

QTabBar::tab {
    background: #16161E;
    color: #787C99;
    padding: 12px 25px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
}

QTabBar::tab:hover {
    background: #1F2335;
    color: #C0CAF5;
}

QTabBar::tab:selected {
    background: #1A1B26;
    color: #7AA2F7;
    border-bottom: 3px solid #7AA2F7;
}

QTabWidget::tab-bar:east {
    alignment: top;
}

QTabBar::tab:east {
    background: #16161E;
    color: #787C99;
    padding: 20px 8px;
    border-left: 2px solid #1A1B26;
    margin-bottom: 5px;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

QTabBar::tab:east:selected {
    background: #24283B;
    color: #BB9AF7;
    border-left: 4px solid #BB9AF7;
}

QPushButton {
    background-color: #1A1B26;
    border: 1px solid #24283B;
    border-radius: 6px;
    color: #C0CAF5;
    padding: 8px 15px;
}

QPushButton:hover {
    background-color: #24283B;
    border-color: #7AA2F7;
}

QPushButton:pressed {
    background-color: #7AA2F7;
    color: #0B0E14;
}

QScrollBar:vertical {
    border: none;
    background: #0B0E14;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #1F2335;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #7AA2F7;
}