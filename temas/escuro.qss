/* --- Elementos do Workspace (Abas) --- */
QToolButton#botaoHomeWorkspace {
    background-color: transparent;
    border: none;
    color: white;
    font-size: 18px;
    margin-left: 5px;
}

QToolButton#botaoHomeWorkspace:hover {
    background-color: #3d3d3d;
    border-radius: 5px;
}

QTabBar {
    background-color: #1a1a1a;
    border: none;
}

QTabWidget::pane {
    border-top: 1px solid #333;
}

/* --- Novos Elementos da Tela Inicial --- */

/* Botão de Configurações (Engrenagem) */
QPushButton#btn_settings {
    background-color: transparent;
    border-radius: 20px;
    color: white;
}

QPushButton#btn_settings:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

/* Botões de Ação (Verdes) */
QPushButton[class="botao-acao"] {
    background-color: #2ecc71;
    font-weight: bold;
    color: white;
    border-radius: 4px;
}

QPushButton[class="botao-acao"]:hover {
    background-color: #27ae60;
}

/* Container dos Cards de Fluxo */
QFrame#card_container {
    background-color: #1e1e1e;
    border: 1px solid #333;
    border-radius: 8px;
}

QFrame#card_container:hover {
    border: 1px solid #3498db;
}

/* Labels dentro dos Cards */
QLabel#label_fluxo {
    color: white;
    font-weight: bold;
    font-size: 14px;
    border: none;
    background: transparent;
}

QLabel#label_modulo {
    color: #000000;
    font-weight: 500;
    font-size: 15px;
    border: none;
}

/* --- Ajuste Fino para ListWidgets (Projetos Recentes) --- */
QListWidget {
    background-color: #252525;
    border: 1px solid #333;
    border-radius: 4px;
    color: #ddd;
    outline: none;
    padding: 0px; /* Espaço interno para a pílula de seleção não colar na borda */
}

QListWidget::item {
    padding: 1px 2px;     /* Reduzido de 10px para 6px na altura para ser mais fino */
    margin: 1px 2px;       /* Margem lateral cria o efeito de pílula isolada */
    border-radius: 4px;    /* Cantos arredondados na seleção */
    color: #cccccc;
    border: none;          /* Removida a linha inferior que poluía o visual */
}

QListWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QListWidget::item:selected {
    background-color: #34495e; /* Azul sóbrio */
    color: #ffffff;
    font-weight: 400;
}

/* Remove qualquer resquício de borda pontilhada de foco */
QListWidget::item:focus {
    border: none;
    outline: none;
}