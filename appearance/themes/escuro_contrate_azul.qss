QMainWindow, QWidget {
    background-color: #121212;
    color: #E0E0E0;
    font-family: 'Segoe UI', sans-serif;
}

QTabWidget::pane {
    border: none;
}

QTabBar::tab {
    background: #1e1e1e;
    padding: 10px 20px;
    border-bottom: 2px solid #333;
}

QTabBar::tab:selected {
    background: #2d2d2d;
    border-bottom: 2px solid #00d4ff;
    color: white;
}

QTabWidget::tab-bar:east {
    alignment: top;
}

QTabBar::tab:east {
    background: #1e1e1e;
    color: #aaa;
    padding: 15px 5px;
    border-left: 1px solid #333;
    margin-bottom: 2px;
}

QTabBar::tab:east:selected {
    background: #00d4ff;
    color: #000;
    font-weight: bold;
}

QPushButton {
    background-color: #333;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 8px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #444;
    border-color: #00d4ff;
}

QPushButton:pressed {
    background-color: #00d4ff;
    color: black;
} /* Chave fechada aqui */

ProjectCardWidget {
    border: 1px solid #444;
    border-radius: 8px;
    background-color: #121212;
}

ProjectCardWidget:hover {
    background-color: #181515;
}