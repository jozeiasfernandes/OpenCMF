/* =========================================================================
   Paleta Atom One Dark (Com alto contraste e destaque visual)
   ========================================================================= */

QWidget {
    background-color: #282c34;
    color: #abb2bf;
}

/* Painéis e containers */
QFrame[tipo="sidebar"], QListWidget {
    background-color: #21252b;
    border: 1px solid #181a1f;
}

/* Botões com maior destaque e bordas aparentes */
QPushButton {
    background-color: #2c313c;
    border: 1px solid #4b5263;
    color: #ffffff;
}

QPushButton:hover {
    background-color: #3e4451;
    border-color: #61afef;
    color: #ffffff;
}

QPushButton[tipo="primary"] {
    background-color: #61afef;
    color: #282c34;
    font-weight: bold;
}

QPushButton[tipo="primary"]:hover {
    background-color: #528bff;
}

/* Inputs */
QLineEdit, QComboBox, QAbstractSpinBox {
    background-color: #1b1f23;
    border: 1px solid #181a1f;
    color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #61afef;
}

/* ScrollBar */
QScrollBar:vertical {
    background: #282c34;
}

QScrollBar::handle:vertical {
    background: #4b5263;
}

QScrollBar::handle:vertical:hover {
    background: #5c6370;
}

/* Listas */
QListWidget::item:selected {
    background-color: #3e4451;
    color: #61afef;
    border-left: 3px solid #61afef;
}

/* Cards de Projeto */
ProjectCardWidget {
    border: 1px solid #444444;
    background-color: #282c34;
}

ProjectCardWidget:hover {
    background-color: #2c313c;
}

/* Títulos */
QLabel#AppTitleLabel {
    color: #ffffff;
}

QLabel#AppTitleLabel:hover {
    color: #61afef;
}

/* Abas da Workspace (Com contraste forte e visível para a aba ativa) */
WorkspaceTabWidget {
    background-color: #21252b;
    border: 1px solid #181a1f;
}

WorkspaceTabWidget QLabel {
    background-color: transparent;
    color: #abb2bf;
}

WorkspaceTabWidget[ativo="true"] {
    background-color: #2c313c;
    border-bottom: 2px solid #61afef;
    color: #61afef;
    font-weight: bold;
}

WorkspaceTabWidget[ativo="true"] QLabel {
    color: #61afef;
}

/* Botão de Fechar da Aba */
WorkspaceTabWidget QPushButton#TabCloseButton {
    background-color: transparent;
    border: none;
    color: transparent;
}

WorkspaceTabWidget[ativo="true"] QPushButton#TabCloseButton,
WorkspaceTabWidget:hover QPushButton#TabCloseButton {
    color: #abb2bf;
}

WorkspaceTabWidget QPushButton#TabCloseButton:hover {
    background-color: #e06c75;
    color: #ffffff;
    border-radius: 2px;
}