/* Paleta Atom One Dark:
   Fundo Principal: #282c34
   Fundo Secundário (Sidebars/Cards): #21252b
   Cor do Texto: #abb2bf
   Destaques: #61afef (Azul), #98c379 (Verde), #c678dd (Roxo), #e5c07b (Amarelo)
*/

QWidget {
    background-color: #282c34;
    color: #abb2bf;
    font-family: 'Segoe UI', 'Roboto', sans-serif;
    font-size: 10pt;
}

/* Painéis laterais e containers */
QFrame[tipo="sidebar"], QListWidget {
    background-color: #21252b;
    border: 1px solid #181a1f;
}

/* Botões Atom Style */
QPushButton {
    background-color: #282c34;
    border: 1px solid #3e4451;
    border-radius: 3px;
    color: #abb2bf;
    padding: 1px 5px;
}
QPushButton:hover {
    background-color: #3e4451;
    color: #ffffff;
}
QPushButton[tipo="primary"] {
    background-color: #61afef;
    color: #282c34;
    font-weight: bold;
    border: none;
}
QPushButton[tipo="primary"]:hover {
    background-color: #528bff;
}

/* Inputs */
QLineEdit, QComboBox, QAbstractSpinBox {
    background-color: #1b1f23;
    border: 1px solid #181a1f;
    border-radius: 1px;
    padding: 1px;
    color: #abb2bf;
}
QLineEdit:focus {
    border: 1px solid #61afef;
}

/* ScrollBar Atom */
QScrollBar:vertical {
    width: 10px;
    background: #282c34;
}
QScrollBar::handle:vertical {
    background: #4b5263;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #5c6370;
}

/* Listas (File Explorer style) */
QListWidget::item {
    padding: 5px;
}
QListWidget::item:selected {
    background-color: #3e4451;
    color: #61afef;
    border-left: 3px solid #61afef;
}

ProjectCardWidget {
    border: 1px solid #444;
    border-radius: 8px;
    background-color: #282c34;
}

ProjectCardWidget:hover {
    background-color: #26262B;
}

/* Estilização Específica para Botões de Ferramentas / Cabeçalho */
QToolButton#HeaderToolButton,
QToolButton#botaoHomeWorkspace {
    background-color: transparent;
    border: none;
    border-radius: 4px;
}

QToolButton#HeaderToolButton:hover,
QToolButton#botaoHomeWorkspace:hover {
    background-color: rgba(100, 100, 100, 40);
}

QToolButton#HeaderToolButton:pressed,
QToolButton#botaoHomeWorkspace:pressed {
    background-color: rgba(100, 100, 100, 70);
}


QLabel#AppTitleLabel {
    font-weight: bold;
    font-size: 16px;
    color: #FFFFFF; /* Branco para o tema escuro */
    background-color: transparent;
}

QLabel#AppTitleLabel:hover {
    color: #61afef; /* Opcional: destaque ao passar o mouse */
}




/* Estilização específica para as abas da Workspace */
WorkspaceTabWidget {
    background-color: #474C52;
    border: 1px solid #181a1f;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

/* Garante que o rótulo do texto acompanhe a cor e o fundo da aba sem caixas extras */
WorkspaceTabWidget QLabel {
    background-color: transparent;
    color: inherit;
}

WorkspaceTabWidget[ativo="true"] {
    background-color: #697386;
    border-bottom: 2px solid #61afef;
    color: #61afef;
}

/* Botão de Fechar da Aba (Mantém o espaço físico para evitar redimensionamento) */
WorkspaceTabWidget QPushButton#TabCloseButton {
    background-color: transparent;
    border: none;
    color: transparent; /* Oculto visualmente, mas ocupa espaço */
    font-weight: bold;
}

/* Exibe o botão de fechar quando a aba está ativa ou com o mouse em cima */
WorkspaceTabWidget[ativo="true"] QPushButton#TabCloseButton,
WorkspaceTabWidget:hover QPushButton#TabCloseButton {
    color: #abb2bf;
}

/* Efeito ao passar o mouse diretamente no botão "×" */
WorkspaceTabWidget QPushButton#TabCloseButton:hover {
    background-color: #e06c75; /* Vermelho suave estilo Atom */
    color: #ffffff;
    border-radius: 2px;
}