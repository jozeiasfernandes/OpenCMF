/* =========================================================================
   Paleta Tema Claro (Light Theme)
   ========================================================================= */

QWidget {
    background-color: #F8F9FA;
    color: #212529;
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 10pt;
    selection-background-color: #A9D0F5;
    selection-color: #212529;
}

QLabel {
    background-color: transparent;
    color: #212529;
}

QLabel[text^="<h3>"], QLabel[text^="<h2>"] {
    color: #2C3E50;
    font-weight: bold;
    margin-bottom: 5px;
}

/* Painéis laterais e containers (Regras específicas antes das genéricas) */
QFrame[tipo="sidebar"], QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
}

QFrame[frameShape="StyledPanel"] {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 5px;
}

QFrame {
    border: none;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: #F1F1F1;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #C1C1C1;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A0A0A0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

/* Inputs */
QLineEdit, QComboBox, QAbstractSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D0D0D0;
    border-radius: 4px;
    padding: 3px;
    color: #212529;
}
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus {
    border: 1px solid #3498DB;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D0D0D0;
    border-radius: 4px;
    color: #212529;
    font-weight: bold;
    padding: 8px 15px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #F0F0F0;
    border: 1px solid #C0C0C0;
}

QPushButton:pressed {
    background-color: #E0E0E0;
}

QPushButton:disabled {
    background-color: #F5F5F5;
    color: #A0A0A0;
    border: 1px solid #E0E0E0;
}

QPushButton[tipo="primary"] {
    background-color: #3498DB;
    color: #FFFFFF;
    border: none;
}
QPushButton[tipo="primary"]:hover {
    background-color: #2980B9;
}

/* Listas */
QListWidget::item {
    padding: 5px;
}
QListWidget::item:selected {
    background-color: #E8F4FD;
    color: #2980B9;
    border-left: 3px solid #3498DB;
}

/* Project Card Adaptado para Tema Claro */
ProjectCardWidget {
    border: 1px solid #D0D0D0;
    border-radius: 8px;
    background-color: #FFFFFF;
}

ProjectCardWidget:hover {
    background-color: #F1F3F5;
    border-color: #BCBDBF;
}

/* Estilização Específica para Botões de Ferramentas / Cabeçalho (Tema Claro) */
QToolButton#HeaderToolButton,
QToolButton#botaoHomeWorkspace {
    background-color: transparent;
    border: none;
    border-radius: 4px;
}

QToolButton#HeaderToolButton:hover,
QToolButton#botaoHomeWorkspace:hover {
    background-color: rgba(0, 0, 0, 20);
}

QToolButton#HeaderToolButton:pressed,
QToolButton#botaoHomeWorkspace:pressed {
    background-color: rgba(0, 0, 0, 40);
}

QLabel#AppTitleLabel {
    font-weight: bold;
    font-size: 16px;
    color: #212529;
    background-color: transparent;
}

QLabel#AppTitleLabel:hover {
    color: #3498DB;
}

/* --- Estilização Específica para as Abas da Workspace (Tema Claro) --- */

WorkspaceTabWidget {
    background-color: #CED4DA;
    border: 1px solid #ADB5BD;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #495057;
    min-height: 32px;
}

WorkspaceTabWidget QLabel {
    background-color: transparent;
    color: inherit;
    padding: 0px 2px;
}

WorkspaceTabWidget[ativo="true"] {
    background-color: #FFFFFF;
    border-bottom: 2px solid #3498DB;
    color: #3498DB;
    font-weight: bold;
}

/* --- Configuração do Botão de Fechar das Abas --- */

WorkspaceTabWidget QPushButton#TabCloseButton {
    background-color: transparent;
    border: none;
    color: transparent;
    font-weight: bold;
    font-size: 14pt;
    margin-right: 4px;
}

WorkspaceTabWidget[ativo="true"] QPushButton#TabCloseButton,
WorkspaceTabWidget:hover QPushButton#TabCloseButton {
    color: #495057;
}

WorkspaceTabWidget QPushButton#TabCloseButton:hover {
    background-color: #E03131;
    color: #FFFFFF;
    border-radius: 2px;
}