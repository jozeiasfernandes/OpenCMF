/* ====================== CONFIGURAÇÕES GLOBAIS ====================== */
QWidget {
    background-color: #1E272E;
    color: #D2D7D9;
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 10pt;
    selection-background-color: #2ECC71;
    selection-color: #FFFFFF;
}

/* ====================== LABELS ====================== */
QLabel {
    background-color: transparent;
    color: #D2D7D9;
}

/* Headers com mais contraste */
QLabel[tipo="header"],
QLabel[header="true"] {
    color: #FFFFFF;
    font-weight: bold;
    font-size: 12pt;
    margin-bottom: 4px;
}

/* ====================== BOTÕES ====================== */
QPushButton {
    background-color: #2C3E50;
    border: 1px solid #455A6F;
    border-radius: 4px;
    color: #FFFFFF;
    font-weight: bold;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #34495E;
    border: 1px solid #5F7A9E;
}

QPushButton:pressed {
    background-color: #1E272E;
    border: 1px solid #2C3E50;
}

/* Botões de ação - cores mais vibrantes e contraste alto */
QPushButton[tipo="sucesso"] {
    background-color: #2ECC71;
    color: #FFFFFF;
    border: none;
}

QPushButton[tipo="sucesso"]:hover {
    background-color: #27AE60;
}

QPushButton[tipo="erro"] {
    background-color: #E74C3C;
    color: #FFFFFF;
    border: none;
}

QPushButton[tipo="erro"]:hover {
    background-color: #C0392B;
}

/* Botão de configurações */
QPushButton#btn_settings {
    background-color: transparent;
    border: none;
    color: #D2D7D9;
    padding: 6px;
    font-weight: normal;
}

QPushButton#btn_settings:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
}

/* ====================== FRAMES E CARDS ====================== */
QFrame {
    border: none;
}

/* Card principal */
QFrame#card_container {
    background-color: #263544;
    border: 1px solid #455A6F;
    border-radius: 8px;
}

QFrame#card_container:hover {
    background-color: #2C3E50;
    border: 1px solid #5F7A9E;
}

/* Cards secundários (usando propriedade dinâmica) */
QFrame[tipo="card"] {
    background-color: #263544;
    border: 1px solid #455A6F;
    border-radius: 6px;
}

QFrame[tipo="card"]:hover {
    background-color: #2C3E50;
    border: 1px solid #5F7A9E;
}