/* Paleta de Alto Contraste:
   Fundo: #000000 (Preto absoluto para máximo contraste)
   Texto: #FFFFFF (Branco absoluto)
   Destaque: #FFFF00 (Amarelo vibrante - a cor mais visível ao olho humano)
   Bordas/Inputs: #00FF00 (Verde Neon)
*/

QWidget {
    background-color: #000000;
    color: #FFFFFF;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 11pt; /* Fonte um pouco maior para facilitar leitura */
    font-weight: bold;
}

/* Botões com bordas grossas e cores sólidas */
QPushButton {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #FFFFFF;
    color: #000000;
    border: 2px solid #FFFF00;
}

/* Estado de foco ou seleção com cor de alerta (Amarelo) */
QPushButton:pressed, QPushButton:checked {
    background-color: #FFFF00;
    color: #000000;
}

/* Entradas de texto muito legíveis */
QLineEdit, QComboBox, QAbstractSpinBox {
    background-color: #000000;
    border: 2px solid #00FF00; /* Verde Neon */
    color: #FFFFFF;
    padding: 5px;
}

QLineEdit:focus {
    border: 1px solid #FFFF00;
}

/* Listas e Containers */
QListWidget, QFrame[tipo="container"] {
    background-color: #000000;
    border: 1px solid #FFFFFF;
}

QListWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
    font-weight: bold;
}

/* ScrollBar de Alto Contraste */
QScrollBar:vertical {
    width: 15px;
    background: #000000;
    border: 1px solid #FFFFFF;
}
QScrollBar::handle:vertical {
    background: #FFFFFF;
}
QScrollBar::handle:vertical:hover {
    background: #FFFF00;
}