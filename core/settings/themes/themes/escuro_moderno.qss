/* ====================== CONFIGURAÇÕES GLOBAIS ====================== */
QWidget {
    background-color: #1E272E;
    color: #D2D7D9;
    selection-background-color: #2ECC71;
    selection-color: #FFFFFF;
}

/* ====================== LABELS ====================== */
QLabel {
    background-color: transparent;
    color: #D2D7D9;
}

/* Headers com mais contraste */
QLabel[tipo="header"],
QLabel[header="true"] {
    color: #FFFFFF;
}

/* ====================== ABAS (QTabBar / QTabWidget) ====================== */
QTabWidget::pane {
    border-color: #455A6F;
    background-color: #1E272E;
}

QTabBar {
    background-color: #1E272E;
}

QTabBar::tab {
    background-color: #263544;
    color: #D2D7D9;
    border-color: #455A6F;
}

QTabBar::tab:hover {
    background-color: #2C3E50;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #2C3E50;
    border-bottom-color: #2ECC71;
    color: #FFFFFF;
}

/* ====================== BOTÕES ====================== */
QPushButton {
    background-color: #2C3E50;
    border-color: #455A6F;
    color: #FFFFFF;
}

QPushButton:hover {
    background-color: #34495E;
    border-color: #5F7A9E;
}

QPushButton:pressed {
    background-color: #1E272E;
    border-color: #2C3E50;
}

/* Botões de ação - cores mais vibrantes e contraste alto */
QPushButton[tipo="sucesso"] {
    background-color: #2ECC71;
    color: #FFFFFF;
}

QPushButton[tipo="sucesso"]:hover {
    background-color: #27AE60;
}

QPushButton[tipo="erro"] {
    background-color: #E74C3C;
    color: #FFFFFF;
}

QPushButton[tipo="erro"]:hover {
    background-color: #C0392B;
}

/* Botão de configurações */
QPushButton#btn_settings {
    background-color: transparent;
    color: #D2D7D9;
}

QPushButton#btn_settings:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
}

/* ====================== FRAMES E CARDS ====================== */
QFrame {
}

/* Card principal */
QFrame#card_container {
    background-color: #263544;
    border-color: #455A6F;
}

QFrame#card_container:hover {
    background-color: #2C3E50;
    border-color: #5F7A9E;
}

/* Cards secundários (usando propriedade dinâmica) */
QFrame[tipo="card"] {
    background-color: #263544;
    border-color: #455A6F;
}

QFrame[tipo="card"]:hover {
    background-color: #2C3E50;
    border-color: #5F7A9E;
}

ProjectCardWidget {
    border-color: #444;
    background-color: #282c34;
}

ProjectCardWidget:hover {
    background-color: #26262B;
}