/* =========================================================================
   Estilos de Cores para Cards (Projetos e Fluxos)
   ========================================================================= */

/* Cards de Projeto */
ProjectCardWidget {
    background-color: #282c34;
}

ProjectCardWidget:hover {
    background-color: #2c313c;
}

/* =========================================================================
   FlowsCard (Editor de Fluxos)
   ========================================================================= */

FlowsCard {
    background-color: transparent;
}

FlowsCard:hover {
    background-color: #2c313c;
}

/* Bloco Principal do Fluxo */
QFrame#FluxoCardMainBlock {
    background-color: #3b4048;
}

QFrame#FluxoCardMainBlock:hover {
    background-color: #4b5263;
}

QLabel#FluxoCardTitleLabel {
    color: #ffffff;
    background-color: transparent;
}

/* Seta de Conexão entre Módulos */
QLabel#FluxoCardArrow {
    color: #5c6370;
    background-color: transparent;
}

/* Blocos Individuais de Módulos */
QLabel#FluxoCardModuleLabel {
    background-color: #21252b;
    color: #abb2bf;
}

QLabel#FluxoCardModuleLabel:hover {
    color: #61afef;
}