/* =========================================================================
   Estilos Estruturais para Diálogos e Janelas de Importação (DICOM)
   ========================================================================= */

QDialog {
    /* Sem propriedades de cor */
}

QTableWidget {
    border-width: 1px;
    border-style: solid;
    /* Cores de fundo, texto, grid, seleção e borda removidas */
}

QHeaderView::section {
    padding: 5px;
    border-width: 1px;
    border-style: solid;
    font-weight: bold;
}

QDoubleSpinBox {
    border-width: 1px;
    border-style: solid;
    padding: 4px;
    border-radius: 2px;
}