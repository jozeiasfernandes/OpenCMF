QWidget {
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 10pt;
}

QLabel {
    background-color: transparent;
}

QListWidget::item:selected {
    border-left-width: 2px;
    border-left-style: solid;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QFrame {
    border: none;
}

QFrame[tipo="sidebar"], QListWidget {
    border-width: 1px;
    border-style: solid;
    /* Sem propriedades de cor: o border-color e background-color ficam no tema */
}

QTabWidget::pane {
    border: none;
}

QTabBar::tab {
    padding: 10px 20px;
    margin-right: 6px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}