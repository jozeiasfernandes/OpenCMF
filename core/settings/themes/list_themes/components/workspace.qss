/* =========================================================================
   Estilos Estruturais para o Workspace e Abas Customizadas
   ========================================================================= */

QTabWidget::pane {
    border-top-width: 1px;
    border-top-style: solid;
}

/* Configuração estrutural do WorkspaceTabWidget */
WorkspaceTabWidget {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-top-width: 1px;
    border-top-style: solid;
    border-left-width: 1px;
    border-left-style: solid;
    border-right-width: 1px;
    border-right-style: solid;
    min-height: 32px;
    margin-right: 1px;
}

WorkspaceTabWidget QLabel {
    padding: 0px 4px;
    background-color: transparent;
}

WorkspaceTabWidget QPushButton#TabCloseButton {
    border: none;
    font-weight: bold;
    font-size: 11pt;
    margin-right: 4px;
    background-color: transparent;
}

WorkspaceTabWidget QPushButton#TabCloseButton:hover {
    border-radius: 2px;
}

/* =========================================================================
   Floating Container (Estrutura)
   ========================================================================= */

#FloatingContainer {
    border-width: 1px;
    border-style: solid;
    border-radius: 6px;
}

#FloatingHeader {
    border-bottom-width: 1px;
    border-bottom-style: solid;
    padding: 8px;
}

#FloatingTitleLabel {
    background-color: transparent;
    font-weight: bold;
}

#FloatingCloseButton {
    border-radius: 4px;
    padding: 4px 8px;
    border-width: 1px;
    border-style: solid;
}