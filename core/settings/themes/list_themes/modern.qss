/* =========================================================================
   Paleta Tema Minimalista Moderno (Apenas Cores)
   ========================================================================= */

QWidget {
    background-color: #E2E8F0;
    color: #1E293B;
    selection-background-color: #CBD5E1;
    selection-color: #1D4ED8;
}

/* Botões Modernos e Limpos */
QPushButton {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
    color: #1E293B;
}

QPushButton:hover {
    background-color: #FFFFFF;
    border-color: #94A3B8;
}

QPushButton:pressed {
    background-color: #CBD5E1;
}

/* Botão de Ação Primário (Azul Moderno Intenso) */
QPushButton[tipo="primary"] {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
    color: #FFFFFF;
}

QPushButton[tipo="primary"]:hover {
    background-color: #1E40AF;
    border-color: #1E40AF;
}

/* Campos de Entrada */
QComboBox, QAbstractSpinBox, QLineEdit {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
    color: #1E293B;
}

QComboBox:focus, QLineEdit:focus, QAbstractSpinBox:focus {
    border-color: #1D4ED8;
}

/* Painéis e Cards */
QFrame[tipo="panel"], QFrame#card_container {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
}

QFrame#card_container:hover {
    border-color: #1D4ED8;
}

/* Listas */
QListWidget {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
}

QListWidget::item:hover {
    background-color: #F1F5F9;
}

QListWidget::item:selected {
    background-color: #E0E7FF;
    color: #1D4ED8;
    border-left-color: #1D4ED8;
}

/* ScrollBar Minimalista */
QScrollBar:vertical {
    background: #E2E8F0;
}

QScrollBar::handle:vertical {
    background: #94A3B8;
}

QScrollBar::handle:vertical:hover {
    background: #64748B;
}

/* Project Cards */
ProjectCardWidget {
    border-color: #CBD5E1;
    background-color: #FFFFFF;
}

ProjectCardWidget:hover {
    background-color: #F8FAFC;
    border-color: #1D4ED8;
}

/* Abas e Workspace */
QTabWidget::pane {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
    border-top-color: #1D4ED8;
}

QTabBar {
    background-color: #CBD5E1;
}

QTabBar::tab {
    background-color: #94A3B8;
    color: #F8FAFC;
    border-color: #64748B;
}

QTabBar::tab:hover {
    background-color: #CBD5E1;
    color: #0F172A;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #1D4ED8;
    border-bottom-color: #FFFFFF;
}

/* WorkspaceTabWidget Específico */
WorkspaceTabWidget {
    background-color: #CBD5E1;
    border-color: #94A3B8;
    color: #475569;
}

WorkspaceTabWidget QLabel {
    background-color: transparent;
    color: inherit;
}

WorkspaceTabWidget[ativo="true"] {
    background-color: #FFFFFF;
    border-bottom-color: #1D4ED8;
    color: #1D4ED8;
}

WorkspaceTabWidget[ativo="true"] QLabel {
    color: #1D4ED8;
}

WorkspaceTabWidget QPushButton#TabCloseButton {
    background-color: transparent;
    color: transparent;
}

WorkspaceTabWidget[ativo="true"] QPushButton#TabCloseButton,
WorkspaceTabWidget:hover QPushButton#TabCloseButton {
    color: #475569;
}

WorkspaceTabWidget QPushButton#TabCloseButton:hover {
    background-color: #FEE2E2;
    color: #DC2626;
}

/* FloatingContainer */
#FloatingContainer {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
}

#FloatingHeader {
    background-color: #F1F5F9;
    border-bottom-color: #CBD5E1;
}

#FloatingTitleLabel {
    color: #1E293B;
    background-color: transparent;
}

#FloatingCloseButton {
    background-color: #FFFFFF;
    color: #475569;
    border-color: #CBD5E1;
}

#FloatingCloseButton:hover {
    background-color: #FEE2E2;
    border-color: #FCA5A5;
    color: #DC2626;
}