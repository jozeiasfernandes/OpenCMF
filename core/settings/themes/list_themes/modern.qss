/* =========================================================================
   Paleta Tema Minimalista Moderno (Apenas Cores)
   ========================================================================= */

QWidget {
    background-color: #BFC3C6;
    color: #1E293B;
    selection-background-color: #CBD5E1;
    selection-color: #1D4ED8;
}

/* Botões Modernos e Limpos */
QPushButton {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
    color: #1E293B;
}

QPushButton:hover {
    background-color: #FFFFFF;
    border-color: #94A3B8;
}

QPushButton:pressed {
    background-color: #CBD5E1;
}

/* Botão de Ação Primário (Azul Moderno Intenso) */
QPushButton[tipo="primary"] {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
    color: #FFFFFF;
}

QPushButton[tipo="primary"]:hover {
    background-color: #1E40AF;
    border-color: #1E40AF;
}

/* Campos de Entrada */
QComboBox, QAbstractSpinBox, QLineEdit {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
    color: #1E293B;
}

QComboBox:focus, QLineEdit:focus, QAbstractSpinBox:focus {
    border-color: #1D4ED8;
}

/* Listas e Cards de Listagem (Fundo do card separado e texto transparente) */
QListWidget {
    background-color: transparent;
    border: none;
}

/* Cor de fundo do card/item da lista */
QListWidget::item {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
    color: #1E293B;
}

/* Garante que qualquer texto/label dentro do item da lista fique com fundo transparente */
QListWidget QLabel {
    background-color: transparent;
    color: inherit;
}

QListWidget::item:hover {
    background-color: #FFFFFF;
    border-color: #94A3B8;
    color: #1E293B;
}

QListWidget::item:selected {
    background-color: #C7D2FE;
    color: #1D4ED8;
    border-color: #1D4ED8;
    border-left-color: #1D4ED8;
}

/* Painéis e Cards */
QFrame[tipo="panel"], QFrame#card_container {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
}

QFrame#card_container:hover {
    border-color: #1D4ED8;
}

/* =========================================================================
   FlowsCard (Editor de Fluxos - Cores)
   ========================================================================= */

FlowsCard {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
}

FlowsCard:hover {
    background-color: #F8FAFC;
    border-color: #1D4ED8;
}

QFrame#FluxoCardMainBlock {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
}

QFrame#FluxoCardMainBlock:hover {
    border-color: #1D4ED8;
}

QLabel#FluxoCardTitleLabel {
    color: #1E293B;
    background-color: transparent;
}

QLabel#FluxoCardArrow {
    color: #64748B;
    background-color: transparent;
}

QLabel#FluxoCardModuleLabel {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
    color: #1E293B;
}

QLabel#FluxoCardModuleLabel:hover {
    background-color: #FFFFFF;
    border-color: #1D4ED8;
}

/* ScrollBar Minimalista */
QScrollBar:vertical {
    background: #E2E8F0;
}

QScrollBar::handle:vertical {
    background: #94A3B8;
}

QScrollBar::handle:vertical:hover {
    background: #64748B;
}

/* Project Cards */
ProjectCardWidget {
    border-color: #CBD5E1;
    background-color: #FFFFFF;
}

ProjectCardWidget:hover {
    background-color: #F8FAFC;
    border-color: #1D4ED8;
}

/* Workspace e Painel de Abas */
QTabWidget::pane {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
    border-top-color: #1D4ED8;
    border-top-width: 1px;
    border-top-style: solid;
}

/* WorkspaceTabWidget Específico (Abas Customizadas) */
WorkspaceTabWidget {
    background-color: #9197A1;
    border: 1px solid #64748B;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #F8FAFC;
}

WorkspaceTabWidget:hover {
    background-color: #CBD5E1;
    color: #0F172A;
}

WorkspaceTabWidget QLabel {
    background-color: transparent;
    color: inherit;
}

WorkspaceTabWidget[ativo="true"] {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-bottom: 2px solid #1D4ED8;
    color: #1D4ED8;
}

WorkspaceTabWidget[ativo="true"] QLabel {
    color: #1D4ED8;
}

WorkspaceTabWidget QPushButton#TabCloseButton {
    background-color: transparent;
    color: transparent;
}


WorkspaceTabWidget[ativo="true"] QPushButton#TabCloseButton,
WorkspaceTabWidget:hover QPushButton#TabCloseButton {
    color: #475569;
}


WorkspaceTabWidget QPushButton#TabCloseButton:hover {
    background-color: #FEE2E2;
    color: #DC2626;
}
/* FloatingContainer */
#FloatingContainer {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
}

#FloatingHeader {
    background-color: #F1F5F9;
    border-bottom-color: #CBD5E1;
}

#FloatingTitleLabel {
    color: #1E293B;
    background-color: transparent;
}

#FloatingCloseButton {
    background-color: #FFFFFF;
    color: #475569;
    border-color: #CBD5E1;
}

#FloatingCloseButton:hover {
    background-color: #FEE2E2;
    border-color: #FCA5A5;
    color: #DC2626;
}