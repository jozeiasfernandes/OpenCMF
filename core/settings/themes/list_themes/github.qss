/* =========================================================================
   Paleta Tema GitHub Dark (Apenas Cores)
   ========================================================================= */

QWidget {
    background-color: #161b22;
    color: #c9d1d9;
}

/* Botões Estilo GitHub */
QPushButton {
    background-color: #21262d;
    border-color: #30363d;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
}

/* Botões de Ação Primários */
QPushButton[tipo="primary"] {
    background-color: #238636;
    border-color: rgba(240, 246, 252, 0.1);
    color: #ffffff;
}

QPushButton[tipo="primary"]:hover {
    background-color: #2ea043;
}

/* Campos de entrada */
QComboBox, QAbstractSpinBox, QLineEdit {
    background-color: #0d1117;
    border-color: #30363d;
    color: #c9d1d9;
}

QComboBox:focus, QLineEdit:focus, QAbstractSpinBox:focus {
    border-color: #58a6ff;
}

/* Cards e Paineis */
QFrame[tipo="panel"] {
    background-color: #0d1117;
    border-color: #30363d;
}

/* Listas */
QListWidget {
    background-color: #0d1117;
    border-color: #30363d;
}

QListWidget::item:selected {
    background-color: #1f242c;
    border-left-color: #f78166; /* Destaque laranja do GitHub */
}

/* ScrollBar GitHub */
QScrollBar:vertical {
    background: #161b22;
}

QScrollBar::handle:vertical {
    background: #30363d;
}

/* Project Cards */
ProjectCardWidget {
    border-color: #444;
    background-color: #282c34;
}

ProjectCardWidget:hover {
    background-color: #26262B;
}

/* Estilos específicos do FloatingContainer */
#FloatingContainer {
    background-color: #161b22;
    border-color: #30363d;
}

#FloatingHeader {
    background-color: #0d1117;
    border-bottom-color: #30363d;
}

#FloatingTitleLabel {
    color: #c9d1d9;
    background-color: transparent;
}

#FloatingCloseButton {
    background-color: #21262d;
    color: #c9d1d9;
    border-color: #30363d;
}

#FloatingCloseButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
    color: #f85149;
}