/* =========================================================================
   Paleta Tema Claro (Apenas Cores)
   ========================================================================= */

QWidget {
    background-color: #F8F9FA;
    color: #212529;
    selection-background-color: #A9D0F5;
    selection-color: #212529;
}

QLabel {
    background-color: transparent;
    color: #212529;
}

/* Painéis laterais e containers */
QFrame[tipo="sidebar"], QListWidget {
    background-color: #FFFFFF;
    border-color: #E0E0E0;
}

QFrame[frameShape="StyledPanel"] {
    background-color: #FFFFFF;
    border-color: #E0E0E0;
}

/* ScrollBar (Apenas Cores) */
QScrollBar:vertical {
    background-color: #F1F1F1;
}

QScrollBar::handle:vertical {
    background-color: #C1C1C1;
}

QScrollBar::handle:vertical:hover {
    background-color: #A0A0A0;
}

/* Inputs */
QLineEdit, QComboBox, QAbstractSpinBox {
    background-color: #FFFFFF;
    border-color: #D0D0D0;
    color: #212529;
}

QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus {
    border-color: #3498DB;
}

/* Botões */
QPushButton {
    background-color: #FFFFFF;
    border-color: #D0D0D0;
    color: #212529;
}

QPushButton:hover {
    background-color: #F0F0F0;
    border-color: #C0C0C0;
}

QPushButton:pressed {
    background-color: #E0E0E0;
}

QPushButton:disabled {
    background-color: #F5F5F5;
    color: #A0A0A0;
    border-color: #E0E0E0;
}

QPushButton[tipo="primary"] {
    background-color: #3498DB;
    color: #FFFFFF;
}

QPushButton[tipo="primary"]:hover {
    background-color: #2980B9;
}

/* Listas */
QListWidget::item:selected {
    background-color: #E8F4FD;
    color: #2980B9;
    border-left-color: #3498DB;
}

/* Project Card (Apenas Cores) */
ProjectCardWidget {
    border-color: #D0D0D0;
    background-color: #FFFFFF;
}

ProjectCardWidget:hover {
    background-color: #F1F3F5;
    border-color: #BCBDBF;
}

/* Ferramentas e Cabeçalho */
QToolButton#HeaderToolButton,
QToolButton#botaoHomeWorkspace {
    background-color: transparent;
}

QToolButton#HeaderToolButton:hover,
QToolButton#botaoHomeWorkspace:hover {
    background-color: rgba(0, 0, 0, 20);
}

QToolButton#HeaderToolButton:pressed,
QToolButton#botaoHomeWorkspace:pressed {
    background-color: rgba(0, 0, 0, 40);
}

QLabel#AppTitleLabel {
    color: #212529;
    background-color: transparent;
}

QLabel#AppTitleLabel:hover {
    color: #3498DB;
}

/* Abas da Workspace */
WorkspaceTabWidget {
    background-color: #CED4DA;
    border-color: #ADB5BD;
    color: #495057;
}

WorkspaceTabWidget QLabel {
    background-color: transparent;
    color: inherit;
}

WorkspaceTabWidget[ativo="true"] {
    background-color: #FFFFFF;
    border-bottom-color: #3498DB;
    color: #3498DB;
}

/* Botão de Fechar da Aba */
WorkspaceTabWidget QPushButton#TabCloseButton {
    background-color: transparent;
    color: transparent;
}

WorkspaceTabWidget[ativo="true"] QPushButton#TabCloseButton,
WorkspaceTabWidget:hover QPushButton#TabCloseButton {
    color: #495057;
}

WorkspaceTabWidget QPushButton#TabCloseButton:hover {
    background-color: #E03131;
    color: #FFFFFF;
}